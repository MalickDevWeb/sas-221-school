# =============================================
# FRONTEND — Variables d'environnement Vite
# =============================================

# URL de l'API backend (utilisée si le proxy Vite ne suffit pas)
VITE_API_URL=http://localhost:3000

# Désactiver le Hot Module Replacement (utile en mode agent)
# DISABLE_HMR=true

# Google Gemini (si appelé directement depuis le frontend)
VITE_GEMINI_API_KEY=

# Firebase (config publique)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Mode mock (true = données fictives, false = API réelle)
VITE_USE_MOCK=false

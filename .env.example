# =============================================
# FRONTEND — Variables d'environnement Vite
# =============================================

# ATTENTION : toute variable VITE_* est recopiée EN CLAIR dans le code envoyé aux navigateurs. N'y mettez jamais un
# secret (clé d'API privée, mot de passe).

# URL de l'API backend. À laisser vide en développement : le proxy Vite envoie /api vers le backend
# (VITE_PROXY_TARGET, 8090 par défaut). En production, seulement si le site et l'API ne sont pas servis par la même
# adresse (ex. https://<backend>/api) ; sinon l'application appelle /api sur sa propre adresse.
# VITE_API_URL=

# Désactiver le Hot Module Replacement (utile en mode agent)
# DISABLE_HMR=true

# IA : aucune fonction d'IA dans cette version (APP-TL-24). Ne jamais mettre de clé d'API d'IA dans une variable
# VITE_* : elle serait publique (voir l'avertissement ci-dessus).

# Google : aucune connexion à un compte Google ni Firebase (APP-TL-26). Les réunions Google Meet sont créées sur
# meet.google.com puis leur lien est collé ; l'agenda s'exporte en .ics. Aucune variable à renseigner.

# Mode mock (true = données fictives, false = API réelle)
VITE_USE_MOCK=false

# Connexion rapide de démonstration (APP-SEC-03) : absente en production par défaut.
# Ne l'activer que pour un déploiement de démonstration : le mot de passe est alors public dans le bundle.
VITE_DEMO_LOGIN=false
VITE_DEMO_PASSWORD=
